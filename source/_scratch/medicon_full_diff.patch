+bool SQLApplet::isValidIdentifier(std::string_view identifier)
+{
+    if (identifier.empty() || identifier.length() > 63) {
+        return false;
+    }
+    return std::regex_match(identifier.begin(), identifier.end(), SQL_IDENTIFIER_RE);
